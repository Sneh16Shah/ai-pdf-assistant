# Copy this file to .env and fill in your values
# cp .env.example .env

# Database
POSTGRES_PASSWORD=your_postgres_password_here

# AI Service - Get your free Groq API key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Image Generation - Get your free Gemini API key: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret for authentication (use a long random string)
JWT_SECRET=your_jwt_secret_here

# NVIDIA NIM — Multimodal AI Pipeline (each model needs its own key from https://build.nvidia.com)
NVIDIA_VLM_API_KEY=nvapi-your_vlm_key_here
NVIDIA_EMBED_API_KEY=nvapi-your_embed_key_here
NVIDIA_RERANK_API_KEY=nvapi-your_rerank_key_here
NVIDIA_IMAGEGEN_API_KEY=nvapi-your_imagegen_key_here
